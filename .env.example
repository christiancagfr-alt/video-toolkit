# VideoToolkit — environment variable names only (no secrets).
# Copy to .env locally if you use env-based overrides; never commit real values.

# Optional: force app data directory (defaults to platform AppData / Application Support)
# VIDEO_TOOLKIT_APPDATA=

# Optional: override bundled/media ffmpeg directory
# VIDEO_TOOLKIT_MEDIA_BIN=

# Packaging / smoke
# VIDEO_TOOLKIT_VERSION=1.7.70
# VIDEO_TOOLKIT_SMOKE_TEST=0
# VIDEO_TOOLKIT_STARTUP_TRACE=
